{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "horizons_movefx:prismaticlaser_impact",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "horizons_movefx:prismaticlaser_flare"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 14,
        "max_particles": 5
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.333
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.5*math.clamp(v.entity_height,0.8,1.8)",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.35
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.floor(v.particle_random_4*4)*90"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(2.4+0.8*v.particle_random_1)*math.clamp(v.entity_height,0.8,1.8)",
          "(2.4+0.8*v.particle_random_1)*math.clamp(v.entity_height,0.8,1.8)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 96,
          "texture_height": 32,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              32,
              32
            ],
            "step_UV": [
              32,
              0
            ],
            "max_frame": 4,
            "frames_per_second": 3,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "(v.particle_age/v.particle_lifetime)",
          "gradient": {
            "0.000": "#FFFFFFFF",
            "0.499": "#FFFFFFFF",
            "0.500": "#F0FFFAE6",
            "0.849": "#F0FFFAE6",
            "0.850": "#64F0F0DC",
            "0.999": "#64F0F0DC",
            "1.000": "#64F0F0DC"
          }
        }
      }
    }
  }
}
