{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "horizons_movefx:moongeistbeam_hitsparks",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "cobblemon:generic/sparkle/bigsparkle"
      }
    },
    "components": {
