{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "horizons_movefx:sunsteelstrike_blaze",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "cobblemon:generic/fire/cloudyfire_white"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 16
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.5*math.clamp(v.entity_height,0.8,1.8)",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5,0.8)"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.floor(v.particle_random_4*4)*90"
      },
      "minecraft:particle_initial_speed": "math.random(2,4)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.7+0.4*v.particle_random_2)*math.clamp(v.entity_height,0.8,1.8)",
          "(0.7+0.4*v.particle_random_2)*math.clamp(v.entity_height,0.8,1.8)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 160,
          "texture_height": 16,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              16,
              16
            ],
            "step_UV": [
              16,
              0
            ],
            "max_frame": 11,
            "frames_per_second": 10,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "(v.particle_age/v.particle_lifetime)",
          "gradient": {
            "0.000": "#FFFFFFFF",
            "0.249": "#FFFFFFFF",
            "0.250": "#FFFFF08C",
            "0.549": "#FFFFF08C",
            "0.550": "#F0FFA03C",
            "0.849": "#F0FFA03C",
            "0.850": "#96DC3C1E",
            "0.999": "#96DC3C1E",
            "1.000": "#96DC3C1E"
          }
        }
      }
    }
