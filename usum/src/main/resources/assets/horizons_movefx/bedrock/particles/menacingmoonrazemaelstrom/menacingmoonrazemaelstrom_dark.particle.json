{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "horizons_movefx:menacingmoonrazemaelstrom_dark",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "cobblemon:generic/smoke/smoke"
      }
    },
    "components": {
