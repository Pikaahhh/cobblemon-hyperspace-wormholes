        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 96,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              16,
              16
            ],
            "step_UV": [
              0,
              16
            ],
            "max_frame": 7,
            "frames_per_second": 6,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "(v.particle_age/v.particle_lifetime)",
          "gradient": {
            "0.000": "#003C1E78",
            "0.299": "#003C1E78",
            "0.300": "#C83C1E78",
            "0.799": "#C83C1E78",
            "0.800": "#A0281450",
            "0.999": "#00140A28",
            "1.000": "#00140A28"
