    "client": ["dev.hyperspacewormholes.hyperspace.HyperspaceClient", "dev.hyperspacewormholes.wormholes.client.WormholesClient"]
  },
  "mixins": ["hyperspace_wormholes.hyperspace.mixins.json", "hyperspace_wormholes.cobblenav.mixins.json", "hyperspace_wormholes.rbrctai.mixins.json",
    "hyperspace_wormholes.rctmod.mixins.json", "hyperspace_wormholes.rustlingspots.mixins.json", "hyperspace_wormholes.wormholes.mixins.json"],
  "depends": {
